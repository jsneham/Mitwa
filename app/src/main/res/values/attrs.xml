<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="MultiSpinnerSearch">
        <attr name="hintText" format="string"/>
    </declare-styleable>

    <!-- Common attributes -->
    <attr name="corner_radius" format="float" />
    <attr name="min_value" format="float" />
    <attr name="max_value" format="float" />
    <attr name="min_start_value" format="float" />
    <attr name="max_start_value" format="float" />
    <attr name="steps" format="float" />
    <attr name="gap" format="float" />
    <attr name="fix_gap" format="float" />
    <attr name="bar_color_mode" format="enum">
        <enum name="solid" value="0" />
        <enum name="gradient" value="1" />
    </attr>
    <attr name="bar_color" format="color" />
    <attr name="bar_gradient_start" format="color" />
    <attr name="bar_gradient_end" format="color" />
    <attr name="bar_highlight_color_mode" format="enum">
        <enum name="solid" value="0" />
        <enum name="gradient" value="1" />
    </attr>
    <attr name="bar_highlight_color" format="color" />
    <attr name="bar_highlight_gradient_start" format="color" />
    <attr name="bar_highlight_gradient_end" format="color" />
    <attr name="thumb_diameter" format="dimension"/>
    <attr name="position" format="enum">
        <enum name="left" value="0" />
        <enum name="right" value="1" />
    </attr>
    <attr name="data_type" format="enum">
        <enum name="_long" value="0" />
        <enum name="_double" value="1" />
        <enum name="_integer" value="2" />
        <enum name="_float" value="3" />
        <enum name="_short" value="4" />
        <enum name="_byte" value="5" />
    </attr>
    <attr name="bar_height" format="dimension"/>
    <attr name="seek_bar_touch_enabled" format="boolean" />

    <!-- Seekbar -->
    <declare-styleable name="CrystalSeekbar" >
        <attr name="corner_radius" />
        <attr name="min_value" />
        <attr name="max_value" />
        <attr name="min_start_value" />
        <attr name="max_start_value" />
        <attr name="steps" />
        <attr name="gap" />
        <attr name="fix_gap" />
        <attr name="bar_height" />
        <attr name="bar_color_mode" />
        <attr name="bar_color" />
        <attr name="bar_gradient_start" />
        <attr name="bar_gradient_end" />
        <attr name="bar_highlight_color_mode" />
        <attr name="bar_highlight_color" />
        <attr name="bar_highlight_gradient_start" />
        <attr name="bar_highlight_gradient_end" />
        <attr name="thumb_diameter" />
        <attr name="position" />
        <attr name="data_type" />
        <attr name="thumb_color" format="color" />
        <attr name="thumb_color_pressed" format="color" />
        <attr name="thumb_image" format="reference" />
        <attr name="thumb_image_pressed" format="reference" />
        <attr name="seek_bar_touch_enabled" />
    </declare-styleable>

    <!-- Range Seekbar -->
    <declare-styleable name="CrystalRangeSeekbar" >
        <attr name="corner_radius" />
        <attr name="min_value" />
        <attr name="max_value" />
        <attr name="min_start_value" />
        <attr name="max_start_value" />
        <attr name="steps" />
        <attr name="gap" />
        <attr name="fix_gap" />
        <attr name="bar_height"/>
        <attr name="bar_color_mode" />
        <attr name="bar_color" />
        <attr name="bar_gradient_start" />
        <attr name="bar_gradient_end" />
        <attr name="bar_highlight_color_mode" />
        <attr name="bar_highlight_color" />
        <attr name="bar_highlight_gradient_start" />
        <attr name="bar_highlight_gradient_end" />
        <attr name="thumb_diameter" />
        <attr name="position" />
        <attr name="data_type" />
        <attr name="left_thumb_color" format="color" />
        <attr name="left_thumb_color_pressed" format="color" />
        <attr name="left_thumb_image" format="reference" />
        <attr name="left_thumb_image_pressed" format="reference" />
        <attr name="right_thumb_color" format="color" />
        <attr name="right_thumb_color_pressed" format="color" />
        <attr name="right_thumb_image" format="reference" />
        <attr name="right_thumb_image_pressed" format="reference" />
        <attr name="seek_bar_touch_enabled" />
    </declare-styleable>

    <declare-styleable name="PageIndicatorView">
        <attr name="piv_orientation">
            <enum name="horizontal" value="0" />
            <enum name="vertical" value="1" />
        </attr>

        <attr name="piv_viewPager" format="reference" />
        <attr name="piv_select" format="integer" />

        <attr name="piv_count" format="integer" />
        <attr name="piv_dynamicCount" format="boolean" />

        <attr name="piv_radius" format="dimension" />
        <attr name="piv_padding" format="dimension" />
        <attr name="piv_strokeWidth" format="dimension" />
        <attr name="piv_scaleFactor" format="float" />
        <attr name="piv_autoVisibility" format="boolean" />

        <attr name="piv_unselectedColor" format="color" />
        <attr name="piv_selectedColor" format="color" />

        <attr name="piv_interactiveAnimation" format="boolean" />
        <attr name="piv_animationDuration" format="integer" />
        <attr name="piv_animationType">
            <enum name="none" value="0" />
            <enum name="color" value="1" />
            <enum name="scale" value="2" />
            <enum name="worm" value="3" />
            <enum name="slide" value="4" />
            <enum name="fill" value="5" />
            <enum name="thinWorm" value="6" />
            <enum name="drop" value="7" />
            <enum name="swap" value="8" />
            <enum name="scale_down" value="9" />
        </attr>
        <attr name="piv_rtl_mode">
            <enum name="on" value="0" />
            <enum name="off" value="1" />
            <enum name="auto" value="2" />
        </attr>
    </declare-styleable>

    <declare-styleable name="SliderView">

        <attr name="sliderIndicatorOrientation">
            <enum name="horizontal" value="0" />
            <enum name="vertical" value="1" />
        </attr>

        <attr name="sliderIndicatorEnabled" format="boolean" />
        <attr name="sliderIndicatorRadius" format="dimension" />
        <attr name="sliderIndicatorPadding" format="dimension" />
        <attr name="sliderIndicatorMargin" format="dimension" />
        <attr name="sliderIndicatorMarginLeft" format="dimension" />
        <attr name="sliderIndicatorMarginRight" format="dimension" />
        <attr name="sliderIndicatorMarginTop" format="dimension" />
        <attr name="sliderIndicatorMarginBottom" format="dimension" />

        <attr name="sliderIndicatorGravity">
            <flag name="bottom" value="80" />
            <flag name="center" value="17" />
            <flag name="center_horizontal" value="1" />
            <flag name="center_vertical" value="16" />
            <flag name="clip_horizontal" value="8" />
            <flag name="clip_vertical" value="128" />
            <flag name="end" value="8388613" />
            <flag name="fill" value="119" />
            <flag name="fill_horizontal" value="7" />
            <flag name="fill_vertical" value="112" />
            <flag name="left" value="3" />
            <flag name="right" value="5" />
            <flag name="start" value="8388611" />
            <flag name="top" value="48" />
        </attr>

        <attr name="sliderIndicatorUnselectedColor" format="color" />
        <attr name="sliderIndicatorSelectedColor" format="color" />
        <attr name="sliderIndicatorAnimationDuration" format="integer" />
        <attr name="sliderAnimationDuration" format="integer" />

        <attr name="sliderIndicatorRtlMode">
            <enum name="on" value="0" />
            <enum name="off" value="1" />
            <enum name="auto" value="2" />
        </attr>

        <attr name="sliderScrollTimeInSec" format="integer" />
        <attr name="sliderAutoCycleEnabled" format="boolean" />
        <attr name="sliderStartAutoCycle" format="boolean" />

        <attr name="sliderAutoCycleDirection">
            <enum name="right" value="0" />
            <enum name="left" value="1" />
            <enum name="back_and_forth" value="2" />
        </attr>

    </declare-styleable>

    <declare-styleable name="ShadowView">
        <attr name="android:foreground"/>
        <attr name="shadowMargin" format="dimension"/>
        <attr name="shadowMarginTop" format="dimension"/>
        <attr name="shadowMarginLeft" format="dimension"/>
        <attr name="shadowMarginRight" format="dimension"/>
        <attr name="shadowMarginBottom" format="dimension"/>
        <attr name="cornerRadius" format="dimension"/>
        <attr name="cornerRadiusTL" format="dimension"/>
        <attr name="cornerRadiusTR" format="dimension"/>
        <attr name="cornerRadiusBL" format="dimension"/>
        <attr name="cornerRadiusBR" format="dimension"/>
        <attr name="foregroundColor" format="color"/>
        <attr name="shadowColor" format="color"/>
        <attr name="shadowDx" format="float"/>
        <attr name="shadowDy" format="float"/>
        <attr name="shadowRadius" format="dimension"/>
        <attr name="backgroundColor" format="color"/>
    </declare-styleable>
    <declare-styleable name="ShadowView_Layout">
        <attr name="layout_gravity">
            <flag name="top"
                value="0x30"/>
            <flag name="bottom"
                value="0x50"/>
            <flag name="left"
                value="0x03"/>
            <flag name="right"
                value="0x05"/>
            <flag name="center_vertical"
                value="0x10"/>
            <flag name="fill_vertical"
                value="0x70"/>
            <flag name="center_horizontal"
                value="0x01"/>
            <flag name="fill_horizontal"
                value="0x07"/>
            <flag name="center"
                value="0x11"/>
            <flag name="fill"
                value="0x77"/>
            <flag name="clip_vertical"
                value="0x80"/>
            <flag name="clip_horizontal"
                value="0x08"/>
            <flag name="start"
                value="0x00800003"/>
            <flag name="end"
                value="0x00800005"/>
        </attr>
    </declare-styleable>
    <declare-styleable name="LikeButton">
        <attr name="icon_type" format="string" />
        <attr name="icon_size" format="dimension|reference"/>
        <attr name="like_drawable" format="reference" />
        <attr name="unlike_drawable" format="reference" />
        <attr name="dots_primary_color" format="color|reference" />
        <attr name="dots_secondary_color" format="color|reference" />
        <attr name="circle_start_color" format="color|reference" />
        <attr name="circle_end_color" format="color|reference" />
        <attr name="liked" format="boolean"/>
        <attr name="is_enabled" format="boolean"/>
        <attr name="anim_scale_factor" format="float"/>
    </declare-styleable>

    <declare-styleable name="AVLoadingIndicatorView">
    <attr name="minWidth" format="dimension" />
    <attr name="maxWidth" format="dimension"/>
    <attr name="minHeight" format="dimension" />
    <attr name="maxHeight" format="dimension"/>
    <attr name="indicatorName" format="string"/>
    <attr name="indicatorColor" format="color"/>
</declare-styleable>

    <declare-styleable name="CountryCodePicker">
        <attr format="integer" name="ccp_defaultCode"/>
        <attr format="color" name="ccp_textColor"/>
        <attr format="color" name="ccp_backgroundColor"/>
        <attr format="dimension" name="ccp_textSize"/>
        <attr format="string" name="ccp_textFont"/>
        <attr format="dimension" name="ccp_arrowSize"/>
        <attr format="string" name="ccp_countryPreference"/>
        <attr format="string" name="ccp_defaultNameCode"/>
        <attr format="boolean" name="ccp_hideNameCode"/>
        <attr format="boolean" name="ccp_keyboardAutoPopOnSearch"/>
        <attr format="string" name="ccp_customMasterCountries"/>
        <attr format="boolean" name="ccp_showFlag"/>
        <attr format="boolean" name="ccp_showFullName"/>
        <attr format="boolean" name="ccp_selectionDialogShowSearch"/>
        <attr format="boolean" name="ccp_clickable"/>
        <attr format="boolean" name="ccp_hidePhoneCode"/>
        <attr format="boolean" name="ccp_enableHint"/>
        <attr format="boolean" name="ccp_enablePhoneAutoFormatter"/>
        <attr format="boolean" name="ccp_setCountryByTimeZone"/>

        <!--For dialog-->
        <attr format="color" name="ccp_dialogTextColor"/>
    </declare-styleable>
</resources>