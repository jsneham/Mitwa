<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lay_first"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dp18"
    android:layout_marginBottom="@dimen/dp18"
    android:background="@color/registration_background1"
    android:orientation="vertical">


    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp18"
        android:layout_marginRight="@dimen/dp18"
        android:layout_marginBottom="@dimen/dp12"
        android:onClick="goBack"
        android:src="@drawable/back" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="@dimen/dp18"
        android:layout_marginRight="@dimen/dp18"
        android:orientation="horizontal">


        <TextView
            style="@style/small_header_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:gravity="center_vertical"
            android:onClick="goBack"
            android:text="Preferences"
            android:textColor="@color/colorAccent" />

        <TextView
            style="@style/small_header_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:gravity="center_vertical"
            android:onClick="onHaveAccountClick"
            android:text=""
            android:textColor="@color/skip_now"
            android:textStyle="italic" />
    </RelativeLayout>

    <TextView
        style="@style/registration_header_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp18"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginRight="@dimen/dp18"
        android:text="Basic Partner Preference"
        android:textColor="@color/actual_black"
        android:textStyle="bold" />

    <androidx.core.widget.NestedScrollView
        android:layout_marginTop="@dimen/dp10"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/registration_background2">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp18"
            android:layout_marginRight="@dimen/dp18"
            android:background="@color/registration_background2"
            android:orientation="vertical">


            <LinearLayout
                android:id="@+id/l1"
                android:layout_alignParentTop="true"
                style="@style/registration_parent_layout"
                android:weightSum="2">

                <ImageView
                    android:id="@+id/iv3"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_heightage_viewprofile" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                <TextView
                    android:text="Height"
                    style="@style/setting_detail_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv2"
                    android:gravity="left" />

                <RelativeLayout
                    android:layout_marginTop="@dimen/dp5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false">

                    <com.matriapp.mobile.crystalrangeseekbar.widgets.CrystalRangeSeekbar
                        android:id="@+id/search_range_height"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:bar_color="#b7b7b7"
                        app:bar_highlight_color="@color/colorAccent"
                        app:data_type="_integer"
                        app:left_thumb_color="@color/colorAccent"
                        app:left_thumb_color_pressed="@color/colorAccent"
                        app:right_thumb_color="@color/colorAccent"
                        app:right_thumb_color_pressed="@color/colorAccent"
                        app:max_value="85"
                        app:min_value="48"
                        />

                    <TextView
                        android:id="@+id/search_tv_min_height"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/search_range_height"
                        android:layout_marginTop="@dimen/dp5"
                        android:fontFamily="@font/regular_slnt"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/search_tv_max_height"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/search_range_height"
                        android:layout_alignParentRight="true"
                        android:layout_marginTop="@dimen/dp5"
                        android:fontFamily="@font/regular_slnt"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                </RelativeLayout>
                </LinearLayout>
                <LinearLayout
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName3"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv3"
                        android:gravity="left"
                        android:text="From Height"></TextView>

                    <com.matriapp.mobile.multispinnerfilter.SingleSpinnerSearch
                        android:id="@+id/spin_height_from"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName3"
                        android:layout_toRightOf="@+id/iv3"
                        android:gravity="left" />
                </LinearLayout>

                <LinearLayout
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp14"
                    android:layout_toRightOf="@+id/iv1"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName4"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv4"
                        android:gravity="left"
                        android:text="To Height"></TextView>

                    <com.matriapp.mobile.multispinnerfilter.SingleSpinnerSearch
                        android:id="@+id/spin_height_to"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName4"
                        android:layout_toRightOf="@+id/iv4"
                        android:gravity="left" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_below="@+id/l1"
                android:id="@+id/v1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginRight="@dimen/dp12"
                android:background="@color/list_divider_line" />


            <LinearLayout
                android:id="@+id/l2"
                android:layout_below="@+id/v1"
                style="@style/registration_parent_layout"
                android:weightSum="2">

                <ImageView
                    android:id="@+id/iv5"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_birthdate_viewprofile" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="Age"
                        style="@style/setting_detail_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv2"
                        android:gravity="left" />

                    <RelativeLayout
                        android:layout_marginTop="@dimen/dp5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false">

                        <com.matriapp.mobile.crystalrangeseekbar.widgets.CrystalRangeSeekbar
                            android:id="@+id/search_range_age"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:bar_color="#b7b7b7"
                            app:bar_highlight_color="@color/colorAccent"
                            app:data_type="_integer"
                            app:left_thumb_color="@color/colorAccent"
                            app:left_thumb_color_pressed="@color/colorAccent"
                            app:max_value="90"
                            app:min_value="18"
                            app:right_thumb_color="@color/colorAccent"
                            app:right_thumb_color_pressed="@color/colorAccent" />

                        <TextView
                            android:id="@+id/search_tv_min_age"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/search_range_age"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentLeft="true"
                            android:layout_marginStart="0dp"
                            android:layout_marginLeft="0dp"
                            android:layout_marginTop="@dimen/dp5"
                            android:fontFamily="@font/regular_slnt"
                            android:gravity="center"

                            android:text="18 Years"
                            android:textColor="@color/black"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/search_tv_max_age"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/search_range_age"
                            android:layout_alignParentRight="true"
                            android:layout_marginTop="@dimen/dp5"
                            android:fontFamily="@font/regular_slnt"
                            android:gravity="center"

                            android:text="65 Years"
                            android:textColor="@color/black"
                            android:textSize="14sp" />

                    </RelativeLayout>
                </LinearLayout>
                <LinearLayout
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName5"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv5"
                        android:gravity="left"
                        android:text="From Age"></TextView>

                    <com.matriapp.mobile.multispinnerfilter.SingleSpinnerSearch
                        android:id="@+id/spin_age_from"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName5"
                        android:layout_toRightOf="@+id/iv5"
                        android:gravity="left" />
                </LinearLayout>

                <LinearLayout
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp14"
                    android:layout_toRightOf="@+id/iv1"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName6"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv6"
                        android:gravity="left"
                        android:text="To Age"></TextView>

                    <com.matriapp.mobile.multispinnerfilter.SingleSpinnerSearch
                        android:id="@+id/spin_age_to"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName6"
                        android:layout_toRightOf="@+id/iv6"
                        android:gravity="left" />
                </LinearLayout>
            </LinearLayout>


            <View
                android:layout_below="@+id/l2"
                android:id="@+id/v2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginRight="@dimen/dp12"
                android:background="@color/list_divider_line" />


            <LinearLayout android:id="@+id/l3" android:layout_below="@+id/v2" style="@style/registration_parent_layout">

                <ImageView
                    android:id="@+id/iv1"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_religion_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName1"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv1"
                        android:gravity="left"
                        android:text="Religion"></TextView>

                    <com.matriapp.mobile.multispinnerfilter.MultiSpinnerSearch
                        android:id="@+id/spin_religion"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName1"
                        android:layout_toRightOf="@+id/iv1" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_below="@+id/l3"
                android:id="@+id/v3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginRight="@dimen/dp12"
                android:background="@color/list_divider_line" />

            <LinearLayout android:id="@+id/l4" android:layout_below="@+id/v3" style="@style/registration_parent_layout">

                <ImageView
                    android:id="@+id/iv2"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_maritalstatus_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName2"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv2"
                        android:gravity="left"
                        android:text="Partner's Marital Status"></TextView>

                    <com.matriapp.mobile.multispinnerfilter.MultiSpinnerSearch
                        android:id="@+id/spin_martial"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName2"
                        android:layout_toRightOf="@+id/iv2" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/v4" android:layout_below="@+id/l4"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginRight="@dimen/dp12"
                android:background="@color/list_divider_line" />

            <Button
                android:layout_alignParentBottom="true"
                android:id="@+id/btn_first_submit"
                style="@style/primary_action_button"
                android:layout_marginTop="@dimen/dp9"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                android:onClick="validFirst"
                android:text="Continue"
                android:textAllCaps="false"
                android:textColor="@color/White"
                android:background="@drawable/round_background"
                android:fontFamily="@font/medium_slnt"
                android:textSize="18sp"
                android:elevation="0dp"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                />


            <include
                android:id="@+id/progressBar"
                android:visibility="gone"
                layout="@layout/layout_loader" />
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>