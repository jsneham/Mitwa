<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/llView"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragments.ProfileVerification.PhotoVerificationFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp20">

        <LinearLayout
            android:layout_marginBottom="@dimen/dp30"
            android:id="@+id/one"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="@drawable/verification_background">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/dp16"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/profileverification_selfie" />

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/adhar_pan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp10"
                    android:layout_toRightOf="@+id/iv"
                    android:text="Selfie Photo" />

                <TextView
                    android:id="@+id/tvDescription"
                    style="@style/adhar_pan_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tvTitle"
                    android:layout_marginLeft="@dimen/dp10"
                    android:layout_toRightOf="@+id/iv"
                    android:text="Self Portrait" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:gravity="center"
            android:layout_below="@+id/one"
            android:layout_marginTop="@dimen/dp30"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/dp128"
                android:layout_height="@dimen/dp160"
                android:theme="@style/Theme.MaterialComponents.Light"
                app:cardCornerRadius="@dimen/dp8"
                app:strokeColor="@color/photos_stroke_color"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/img_id_self"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp160"
                    android:background="@drawable/add_image_shape_cover_new"
                    android:scaleType="centerCrop"
                    android:src="@drawable/add_image_shape_cover_new" />



                <ImageView
                    android:id="@+id/img_edit_self"
                    android:layout_width="@dimen/dp21"
                    android:layout_height="@dimen/dp21"
                    android:layout_gravity="bottom|right"
                    android:layout_margin="@dimen/dp8"
                    android:src="@drawable/ic_group_more_hor"
                    android:visibility="gone" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>


        <TextView
            android:id="@+id/btnNeedHelp"
            style="@style/popup_bottom_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="Need Help?"
            android:textColor="@color/colorAccent" />
    </RelativeLayout>

    <include
        layout="@layout/layout_loader"
        android:visibility="gone" />
</RelativeLayout>