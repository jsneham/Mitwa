<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/llProfileCreate"
    android:background="@color/white"
    android:layout_height="match_parent">

    <!--
    OUTLINE
	<CoordinatorLayout>
		<AppbarLayout>
   			<CollapsingToolbarLayout>
   	 			<ImageView/>
	 			<Toolbar/>
    		</CollapsingToolbarLayout>
   			<TabLayout/>
		</ AppbarLayout >
		<Scrollable View.../>
	</CoordinatorLayout>
    -->

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentScrim="@drawable/gradient_toolbar"
            android:fitsSystemWindows="true"
            app:layout_scrollFlags="scroll|snap|exitUntilCollapsed">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="500dp"
                android:descendantFocusability="blocksDescendants">

                <ImageView
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"
                    android:id="@+id/imgProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!--            android:background="@drawable/background_with_shadow"
                                      android:padding="15dp"-->

                <ImageView
                    android:layout_marginTop="?attr/actionBarSize"
                    android:id="@+id/imgEdit"
                    android:layout_width="@dimen/dp60"
                    android:layout_height="@dimen/dp50"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_managephotos__1_"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ProgressBar
                    android:id="@+id/circularProgressbar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_centerInParent="true"
                    android:indeterminate="false"
                    android:max="100"
                    android:progressBackgroundTint="@color/white"
                    android:progressDrawable="@drawable/circular_progree"
                    android:secondaryProgress="100"
                    app:layout_constraintBottom_toTopOf="@+id/llButtons"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_pro_per"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:textColor="@color/red"
                    android:background="@drawable/background_with_shadow"
                    app:layout_constraintBottom_toBottomOf="@+id/circularProgressbar"
                    app:layout_constraintEnd_toEndOf="@+id/circularProgressbar"
                    app:layout_constraintStart_toStartOf="@+id/circularProgressbar"
                    app:layout_constraintTop_toTopOf="@+id/circularProgressbar" />

                <LinearLayout
                    android:layout_marginBottom="@dimen/dp13_5"
                    app:layout_constraintBottom_toBottomOf="@+id/imgProfile"
                    android:id="@+id/llButtons"
                    android:gravity="center_horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatButton
                        android:onClick="openManagePhotos"
                        android:layout_margin="@dimen/dp5"
                        android:background="@drawable/view_my_profile_buttons"
                        android:textColor="@color/gradient_color_1"
                        android:textSize="@dimen/sp10"
                        android:textAllCaps="false"
                        android:fontFamily="@font/medium_slnt"
                        android:text="Manage Photos"
                        android:paddingLeft="@dimen/dp16"
                        android:paddingRight="@dimen/dp16"
                        android:paddingTop="@dimen/dp6"
                        android:paddingBottom="@dimen/dp6"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp35"
                        />

                    <androidx.appcompat.widget.AppCompatButton
                        android:onClick="goToPreviewProfile"
                        android:layout_marginTop="@dimen/dp5"
                        android:layout_marginBottom="@dimen/dp5"
                        android:background="@drawable/view_my_profile_buttons"
                        android:textColor="@color/gradient_color_1"
                        android:textSize="@dimen/sp10"
                        android:textAllCaps="false"
                        android:fontFamily="@font/medium_slnt"
                        android:text="Preview Profile"
                        android:paddingLeft="@dimen/dp16"
                        android:paddingRight="@dimen/dp16"
                        android:paddingTop="@dimen/dp6"
                        android:paddingBottom="@dimen/dp6"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp35" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:onClick="goToOnePager"
                        android:layout_margin="@dimen/dp5"
                        android:background="@drawable/view_my_profile_buttons"
                        android:textColor="@color/gradient_color_1"
                        android:textAllCaps="false"
                        android:textSize="@dimen/sp10"
                        android:fontFamily="@font/medium_slnt"
                        android:text="Download Profile"
                        android:paddingLeft="@dimen/dp16"
                        android:paddingRight="@dimen/dp16"
                        android:paddingTop="@dimen/dp6"
                        android:paddingBottom="@dimen/dp6"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp35"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:theme="@style/toolbar_theme"
                app:layout_collapseMode="pin" >
                <TextView
                    android:textSize="18sp"
                    android:fontFamily="@font/medium_slnt"
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp37"
            android:background="@drawable/gradient_toolbar_for_sub_tab"
            app:tabGravity="fill"
            app:tabMode="fixed"
            android:elevation="@dimen/dp1"
            app:tabTextAppearance="@style/sub_tab_text"
            app:tabIndicatorColor="@color/gradient_color_1"
            app:tabSelectedTextColor="@color/sub_tab_active_color"
            app:tabTextColor="@color/sub_tab_default_color"
            />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="@dimen/dp16"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/cdLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include layout="@layout/premiummemebrsheet" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>