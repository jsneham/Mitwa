<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:id="@+id/llView"
    tools:context="com.matriapp.mobile.activities.ChangePasswordActivity">

    <include
        layout="@layout/layout_loader"
        android:visibility="gone" />

    <androidx.appcompat.widget.Toolbar
        android:layout_alignParentTop="true"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/gradient_toolbar"
        android:theme="@style/toolbar_theme"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_scrollFlags="scroll|enterAlways"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <RelativeLayout
        android:layout_below="@+id/toolbar"
        android:id="@+id/linearLayout10"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp18"
        android:background="@color/white"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_old"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp5"
                app:hintAnimationEnabled="false"
                app:hintEnabled="false"
                app:passwordToggleTint="@color/eyeIconPassword"
                app:boxBackgroundMode="none"
                app:passwordToggleEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_old_password"
                    style="@style/login_text"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp60"
                    android:background="@drawable/login_text_background"
                    android:drawableStart="@drawable/ic_password"
                    android:drawableLeft="@drawable/ic_password"
                    android:drawablePadding="@dimen/dp10"
                    android:hint="Enter Existing Password"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:padding="@dimen/dp10"
                    android:textColor="@color/registration_active_color"
                    android:textColorHint="@color/registration_hint_color"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                app:boxBackgroundMode="none"
                android:id="@+id/input_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp5"
                app:hintAnimationEnabled="false"
                app:hintEnabled="false"
                app:passwordToggleTint="@color/eyeIconPassword"
                app:passwordToggleEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_new_password"
                    style="@style/login_text"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp60"

                    android:background="@drawable/login_text_background"
                    android:drawableStart="@drawable/ic_password"
                    android:drawableLeft="@drawable/ic_password"
                    android:drawablePadding="@dimen/dp10"
                    android:hint="Enter New Password"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:padding="@dimen/dp10"
                    android:textColor="@color/registration_active_color"
                    android:textColorHint="@color/registration_hint_color" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                app:boxBackgroundMode="none"
                android:id="@+id/input_con"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
