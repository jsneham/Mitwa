<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:rsb="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/llView"
    android:background="@color/white"
    android:padding="5dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/dp18"
                android:gravity="center"
                android:orientation="vertical">

                <!--                <androidx.cardview.widget.CardView-->
                <!--                    android:layout_width="match_parent"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:layout_margin="10dp"-->
                <!--                    app:cardCornerRadius="5dp">-->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            style="@style/register_dropdown_icon_adv_serach"
                            android:layout_width="@dimen/dp24"
                            android:layout_height="@dimen/dp24"
                            android:layout_alignParentLeft="true"
                            android:src="@drawable/ic_heightage_search" />

                        <TextView
                            android:id="@+id/tv_height_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/medium_slnt"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text=" Height"
                            android:textColor="@color/black"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipChildren="false">

                        <com.matriapp.mobile.crystalrangeseekbar.widgets.CrystalRangeSeekbar
                            android:id="@+id/search_range_height"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:bar_color="#b7b7b7"
                            app:bar_highlight_color="@color/colorAccent"
                            app:data_type="_integer"
                            app:left_thumb_color="@color/colorAccent"
                            app:left_thumb_color_pressed="@color/colorAccent"
                            app:max_value="85"
                            app:min_value="48"
                            app:right_thumb_color="@color/colorAccent"
                            app:right_thumb_color_pressed="@color/colorAccent" />

                        <TextView
                            android:id="@+id/search_tv_min_height"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/search_range_height"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/regular_slnt"
                            android:gravity="center"
                            android:padding="10dp"
                            android:text="0"
                            android:textColor="@color/black"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/search_tv_max_height"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/search_range_height"
                            android:layout_alignParentRight="true"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/regular_slnt"
                            android:gravity="center"
                            android:padding="10dp"
                            android:text="0"
                            android:textColor="@color/black"
                            android:textSize="14sp" />

                    </RelativeLayout>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            style="@style/register_dropdown_icon_adv_serach"
                            android:layout_width="@dimen/dp24"
                            android:layout_height="@dimen/dp24"
                            android:layout_alignParentLeft="true"
                            android:src="@drawable/ic_birthdate_search" />

                        <TextView
                            android:id="@+id/tv_weight_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/medium_slnt"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text=" Age"
                            android:textColor="@color/black"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipChildren="false">

                        <com.matriapp.mobile.crystalrangeseekbar.widgets.CrystalRangeSeekbar
                            android:id="@+id/search_range_age"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:bar_color="#b7b7b7"
                            app:bar_highlight_color="@color/colorAccent"
                            app:data_type="_integer"
                            app:left_thumb_color="@color/colorAccent"
                            app:left_thumb_color_pressed="@color/colorAccent"
                            app:max_value="90"
                            app:min_value="18"
                            app:right_thumb_color="@color/colorAccent"
                            app:right_thumb_color_pressed="@color/colorAccent" />

                        <TextView
                            android:id="@+id/search_tv_min_age"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/search_range_age"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentLeft="true"
                            android:layout_marginStart="0dp"
                            android:layout_marginLeft="0dp"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/regular_slnt"
                            android:gravity="center"
                            android:padding="10dp"
                            android:text="18 Years"
                            android:textColor="@color/black"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/search_tv_max_age"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/search_range_age"
                            android:layout_alignParentRight="true"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/regular_slnt"
                            android:gravity="center"
                            android:padding="10dp"
                            android:text="65 Years"
                            android:textColor="@color/black"
                            android:textSize="14sp" />

                    </RelativeLayout>


                </LinearLayout>

                <!--                </androidx.cardview.widget.CardView>-->

                <RelativeLayout style="@style/register_dropdown_adv_search_layout">

                    <ImageView

                        android:id="@+id/iv1"
                        style="@style/register_dropdown_icon_adv_serach"
                        android:layout_width="@dimen/dp24"
                        android:layout_height="@dimen/dp24"
                        android:layout_alignParentLeft="true"
                        android:src="@drawable/ic_maritalstatus_search" />

                    <com.matriapp.mobile.multispinnerfilter.MultiSpinnerSearch
                        android:id="@+id/spin_mari"
                        style="@style/register_dropdown"
                        android:layout_toRightOf="@+id/iv1" />
                </RelativeLayout>

                <RelativeLayout style="@style/register_dropdown_adv_search_layout">

                    <ImageView
                        android:id="@+id/iv2"
                        style="@style/register_dropdown_icon_adv_serach"
                        android:layout_width="@dimen/dp24"
                        android:layout_height="@dimen/dp24"
                        android:src="@drawable/ic_religion_search" />

                    <com.matriapp.mobile.multispinnerfilter.MultiSpinnerSearch
                        android:id="@+id/spin_religion"
                        style="@style/register_dropdown"
                        android:layout_toRightOf="@+id/iv2" />
                </RelativeLayout>

                <RelativeLayout style="@style/register_dropdown_adv_search_layout">

                    <ImageView
                        android:id="@+id/iv3"
                        style="@style/register_dropdown_icon_adv_serach"
                        android:layout_width="@dimen/dp24"
                        android:layout_height="@dimen/dp24"
                        android:src="@drawable/ic_caste_search" />

                    <com.matriapp.mobile.multispinnerfilter.MultiSpinnerSearch
                        android:id="@+id/spin_caste"
                        style="@style/register_dropdown"
                        android:layout_toRightOf="@+id/iv3" />
                </RelativeLayout>

                <RelativeLayout style="@style/register_dropdown_adv_search_layout">

                    <ImageView
                        android:id="@+id/iv4"
                        style="@style/register_dropdown_icon_adv_serach"
                        android:layout_width="@dimen/dp24"
                        android:layout_height="@dimen/dp24"
                        android:src="@drawable/ic_mothertongue_search" />

                    <com.matriapp.mobile.multispinnerfilter.MultiSpinnerSearch
                        android:id="@+id/spin_tongue"
                        style="@style/register_dropdown"
                        android:layout_toRightOf="@+id/iv4" />
                </RelativeLayout>

                <RelativeLayout style="@style/register_dropdown_adv_search_layout">

                    <ImageView
                        android:id="@+id/iv5"
                        style="@style/register_dropdown_icon_adv_serach"
                        android:layout_width="@dimen/dp24"
                        android:layout_height="@dimen/dp24"
                        android:src="@drawable/ic_citizenshipresidenttype_search" />

                    <com.matriapp.mobile.multispinnerfilter.MultiSpinnerSearch
                        android:id="@+id/spin_country"
                        style="@style/register_dropdown"
                        android:layout_toRightOf="@+id/iv5" />
                </RelativeLayout>

                <RelativeLayout style="@style/register_dropdown_adv_search_layout">

                    <ImageView
                        android:id="@+id/iv6"
                        style="@style/register_dropdown_icon_adv_serach"
                        android:layout_width="@dimen/dp24"
                        android:layout_height="@dimen/dp24"
                        android:src="@drawable/ic_state_search" />

                    <com.matriapp.mobile.multispinnerfilter.MultiSpinnerSearch
                        android:id="@+id/spin_state"
                        style="@style/register_dropdown"
                        android:layout_toRightOf="@+id/iv6" />
                </RelativeLayout>

                <RelativeLayout style="@style/register_dropdown_adv_search_layout">

                    <ImageView
                        android:id="@+id/iv7"
                        style="@style/register_dropdown_icon_adv_serach"
                        android:layout_width="@dimen/dp24"
                        android:layout_height="@dimen/dp24"
                        android:src="@drawable/ic_citylocation_search" />

                    <com.matriapp.mobile.multispinnerfilter.MultiSpinnerSearch
                        android:id="@+id/spin_city"
                        style="@style/register_dropdown"
                        android:layout_toRightOf="@+id/iv7" />
                </RelativeLayout>

                <RelativeLayout style="@style/register_dropdown_adv_search_layout">

                    <ImageView
                        android:id="@+id/iv8"
                        style="@style/register_dropdown_icon_adv_serach"
                        android:layout_width="@dimen/dp24"
                        android:layout_height="@dimen/dp24"
                        android:src="@drawable/ic_education_search" />

                    <com.matriapp.mobile.multispinnerfilter.MultiSpinnerSearch
                        android:id="@+id/spin_edu"
                        style="@style/register_dropdown"
                        android:layout_toRightOf="@+id/iv8" />
                </RelativeLayout>

                <CheckBox
                    android:id="@+id/chk_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:padding="10dp"
                    android:text="With Photo"
                    android:textColor="@color/black" />

                <Button
                    android:id="@+id/btn_search"
                    style="@style/primary_action_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/round_effect"
                    android:text="Search"
                    android:textAllCaps="false"
                    android:textColor="@color/White" />

                <Button
                    style="@style/Widget.MyApp.WhiteButton"
                    android:id="@+id/btn_save_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:text="Save Search"
                    android:textAllCaps="false"
                    android:textColor="@color/colorPrimary"  />


            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/progressBar"
        android:visibility="gone"
        layout="@layout/layout_loader" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>