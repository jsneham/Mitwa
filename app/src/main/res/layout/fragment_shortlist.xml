<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/llView"
    android:background="@color/app_background"
    tools:context="com.matriapp.mobile.activities.ShortlistedProfileActivity">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <ListView
        android:id="@+id/lv_short"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <TextView
        android:fontFamily="@font/regular_slnt"
        android:gravity="center"
        android:id="@+id/tv_no_data"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="18dp"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="18dp"
        android:padding="@dimen/dp25"
        android:text="Profiles shorlisted by you will appear here.
Use the shortlist icon available on a member's profile to shortlist that member."
        android:textColor="@color/actual_black"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/lv_short" />

    <include android:visibility="gone"
        layout="@layout/layout_loader"
        android:id="@+id/progressBar"/>

</androidx.constraintlayout.widget.ConstraintLayout>
