<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="@drawable/gradient_toolbar"
        android:theme="@style/toolbar_theme"
        app:layout_scrollFlags="scroll|enterAlways"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />
    <!-- ImageView at the top -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gradient_color_1"
        android:gravity="center">

        <ImageView
            android:id="@+id/topImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/profileverificationtopimage"
            android:background="@drawable/gradient_toolbar"
            android:theme="@style/toolbar_theme"/>
    </LinearLayout>


    <!-- TabLayout for tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp47"
        android:background="@drawable/gradient_toolbar"
        android:elevation="@dimen/dp1"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/White"
        app:tabMode="auto"
        app:tabSelectedTextColor="@color/White"
        app:tabTextAppearance="@style/tab_text"
        app:tabTextColor="@color/tab_default_color_if_gradient" />

    <!-- ViewPager2 for swiping -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>

