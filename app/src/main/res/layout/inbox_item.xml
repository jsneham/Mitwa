<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp18"
    android:layout_marginRight="@dimen/dp18"
    android:layout_marginTop="@dimen/dp12"
    android:layout_marginBottom="@dimen/dp12"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/view_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_row_background">

        <ImageView
            android:id="@+id/delete_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="10dp"
            android:src="@drawable/trash_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginRight="10dp"
            android:layout_toLeftOf="@id/delete_icon"
            android:text="Delete"
            android:textColor="#fff"
            android:textSize="13dp" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/view_foreground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/White">


            <androidx.cardview.widget.CardView
                app:cardElevation="0dp"
                android:id="@+id/cvImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/dp10"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                    <ImageView
                        android:id="@+id/img_profile"
                        android:layout_width="@dimen/dp70"
                        android:layout_height="@dimen/dp70"
                        android:scaleType="centerCrop">

                    </ImageView>


                    <RelativeLayout
                        android:id="@+id/lay_online"
                        android:layout_width="@dimen/dp10"
                        android:layout_height="@dimen/dp10"
                        android:layout_gravity="bottom|right"
                        android:layout_margin="@dimen/dp3"
                        android:background="@drawable/ic_online"
                        android:visibility="gone" />

                    <RelativeLayout
                        android:id="@+id/lay_ofline"
                        android:layout_width="@dimen/dp10"
                        android:layout_height="@dimen/dp10"
                        android:layout_gravity="bottom|right"
                        android:layout_margin="@dimen/dp3"
                        android:background="@drawable/ic_offline"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>


            <TextView
                android:id="@+id/tv_name"
                style="@style/message_medium_header_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                app:layout_constraintStart_toEndOf="@+id/cvImage"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_msg"
                style="@style/message_medium_details_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginTop="@dimen/dp4"
                app:layout_constraintStart_toEndOf="@+id/cvImage"
                app:layout_constraintTop_toBottomOf="@+id/tv_name" />

            <TextView
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginTop="@dimen/dp4"
                android:id="@+id/tv_date"
                style="@style/message_small_date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09 sept 2021- 11:23 am"
                app:layout_constraintStart_toEndOf="@+id/cvImage"
                app:layout_constraintTop_toBottomOf="@+id/tv_msg" />

            <TextView
                android:id="@+id/tv_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:background="@drawable/round_background"
                android:padding="@dimen/dp4"
                android:text="0"
                android:textColor="@color/White"
                android:textStyle="bold"
                android:visibility="invisible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_date" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:paddingTop="10dp"
            android:layout_alignParentBottom="true"
            android:background="@color/lighter_gray"/>
    </RelativeLayout>

</FrameLayout>