<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lay_first"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dp18"
    android:layout_marginBottom="@dimen/dp18"
    android:fitsSystemWindows="true"
    android:background="@color/registration_background1"
    android:orientation="vertical">



    <ImageView android:onClick="goBack"
        android:layout_marginLeft="@dimen/dp18"
        android:layout_marginRight="@dimen/dp18"
        android:layout_marginBottom="@dimen/dp12"
        android:src="@drawable/back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <RelativeLayout
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp18"
        android:layout_marginRight="@dimen/dp18"
        android:orientation="horizontal">


        <TextView

            android:gravity="center_vertical"
            style="@style/small_header_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:text="Welcome"
            android:textColor="@color/colorAccent" />

        <TextView
            android:gravity="center_vertical"
            style="@style/small_header_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:onClick="onHaveAccountClick"
            android:text="Have an account? Login"
            android:textColor="@color/skip_now"
            android:textStyle="italic" />
    </RelativeLayout>


    <TextView
        style="@style/registration_header_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp18"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginRight="@dimen/dp18"
        android:text="Let's create the Account"
        android:textColor="@color/actual_black"
        android:textStyle="bold" />

    <androidx.core.widget.NestedScrollView
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/registration_background2"
            android:orientation="vertical">





            <EditText
                android:id="@+id/et_email"
                style="@style/registration_text"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp50"
                android:background="@null"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:textColor="@color/registration_active_color"
                android:textColorHint="@color/registration_hint_color">

            </EditText>

            <View
                android:layout_marginLeft="@dimen/dp18"
                android:layout_marginRight="@dimen/dp18"
                android:layout_below="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/text_divider_line" />


            <Button
                android:layout_alignParentBottom="true"
                android:onClick="validFirst"
                android:id="@+id/btn_first_submit"
                style="@style/primary_action_button"
                android:layout_marginLeft="@dimen/dp18"
                android:layout_marginTop="@dimen/dp9"
                android:layout_marginRight="@dimen/dp18"
                android:text="Continue"
                android:textAllCaps="false"
                android:textColor="@color/White" />



            <include android:visibility="gone"
                layout="@layout/layout_loader"
                android:id="@+id/progressBar"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>