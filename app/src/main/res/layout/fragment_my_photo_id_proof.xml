<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/llView"
    android:background="@color/app_background"
    tools:context="com.matriapp.mobile.fragments.MyPhotoFragment">

    <androidx.core.widget.NestedScrollView
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >


            <LinearLayout
                android:visibility="gone"
                android:id="@+id/llPhotoView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    style="@style/photo_header_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp24"
                    android:layout_marginRight="@dimen/dp24"
                    android:text="Profile Photos"></TextView>


                <LinearLayout
                    android:layout_gravity="center"
                    android:weightSum="2"
                    android:layout_width="@dimen/dp300"
                    android:layout_height="@dimen/dp187"
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp18"
                    android:layout_marginRight="@dimen/dp24"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:theme="@style/Theme.MaterialComponents.Light"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/photos_stroke_color"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginRight="@dimen/dp18"
                        android:layout_weight="1"
                        app:cardCornerRadius="@dimen/dp8"

                        >

                        <ImageView
                            android:id="@+id/img_one"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:adjustViewBounds="true"
                            android:background="@drawable/add_image_shape_cover"
                            />

                        <ImageView
                            android:id="@+id/img_plus_one"
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:layout_gravity="bottom|left"
                            android:padding="@dimen/dp8"
                            android:src="@drawable/about_pink"
                            android:visibility="gone"
                            app:tint="@color/colorAccent" />

                        <ImageView
                            android:id="@+id/img_edit_one"
                            android:layout_width="@dimen/dp21"
                            android:layout_height="@dimen/dp21"
                            android:layout_gravity="bottom|right"
                            android:layout_margin="@dimen/dp8"
                            android:src="@drawable/ic_group_more_hor"
                            android:visibility="gone"  />




                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:theme="@style/Theme.MaterialComponents.Light"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/photos_stroke_color"
                        android:id="@+id/cardView3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:cardCornerRadius="@dimen/dp8">

                        <ImageView
                            android:id="@+id/img_two"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:adjustViewBounds="true"
                            android:background="@drawable/add_image_shape_cover" />

                        <ImageView
                            android:id="@+id/img_plus_two"
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:layout_gravity="bottom|left"
                            android:padding="@dimen/dp8"
                            android:src="@drawable/about_pink"
                            android:visibility="gone"
                            app:tint="@color/colorAccent" />

                        <ImageView
                            android:id="@+id/img_edit_two"
                            android:layout_width="@dimen/dp21"
                            android:layout_height="@dimen/dp21"
                            android:layout_gravity="bottom|right"
                            android:layout_margin="@dimen/dp8"
                            android:src="@drawable/ic_group_more_hor"
                            android:visibility="gone" />

                    </com.google.android.material.card.MaterialCardView>




                </LinearLayout>

                <LinearLayout
                    android:layout_gravity="center"
                    android:weightSum="2"
                    android:layout_width="@dimen/dp300"
                    android:layout_height="@dimen/dp187"
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp18"
                    android:layout_marginRight="@dimen/dp24"
                    android:layout_marginBottom="@dimen/dp24"
                    android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView
                        android:theme="@style/Theme.MaterialComponents.Light"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/photos_stroke_color"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginRight="@dimen/dp18"
                        android:layout_weight="1"
                        app:cardCornerRadius="@dimen/dp8">

                        <ImageView
                            android:id="@+id/img_three"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:adjustViewBounds="true"
                            android:background="@drawable/add_image_shape_cover"/>

                        <ImageView
                            android:id="@+id/img_plus_three"
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:layout_gravity="bottom|left"
                            android:padding="@dimen/dp8"
                            android:src="@drawable/about_pink"

                            android:visibility="gone"
                            app:tint="@color/colorAccent" />

