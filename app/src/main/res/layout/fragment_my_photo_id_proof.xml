                            android:layout_height="@dimen/dp21"
                            android:layout_gravity="bottom|right"
                            android:layout_margin="@dimen/dp8"
                            android:src="@drawable/ic_group_more_hor"
                            android:visibility="gone" />

                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:theme="@style/Theme.MaterialComponents.Light"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/photos_stroke_color"
                        android:id="@+id/cardView2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"

                        android:layout_weight="1"
                        app:cardCornerRadius="@dimen/dp8">

                        <ImageView
                            android:id="@+id/img_four"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:adjustViewBounds="true"
                            android:background="@drawable/add_image_shape_cover" />

                        <ImageView
                            android:id="@+id/img_plus_four"
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:layout_gravity="bottom|left"
                            android:padding="@dimen/dp8"

                            android:src="@drawable/about_pink"
                            android:visibility="gone"
                            app:tint="@color/colorAccent" />

                        <ImageView
                            android:id="@+id/img_edit_four"
                            android:layout_width="@dimen/dp21"
                            android:layout_height="@dimen/dp21"
                            android:layout_gravity="bottom|right"
                            android:layout_margin="@dimen/dp8"
                            android:src="@drawable/ic_group_more_hor"
                            android:visibility="gone" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:visibility="gone"
                        android:theme="@style/Theme.MaterialComponents.Light"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/photos_stroke_color"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginRight="@dimen/dp18"
                        android:layout_weight="1"
                        app:cardCornerRadius="@dimen/dp8">

                        <ImageView
                            android:id="@+id/img_five"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/placeholder" />

                        <ImageView
                            android:id="@+id/img_plus_five"
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:layout_gravity="bottom|left"
                            android:background="@drawable/background_with_shadow"
                            android:padding="@dimen/dp8"
                            android:src="@drawable/about_pink"
                            android:visibility="gone"
                            app:tint="@color/colorAccent" />

                        <ImageView
                            android:id="@+id/img_edit_five"
                            android:layout_width="@dimen/dp21"
                            android:layout_height="@dimen/dp21"
                            android:layout_gravity="bottom|right"
                            android:layout_margin="@dimen/dp8"
                            android:src="@drawable/ic_group_more_hor"
                            android:visibility="gone" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:theme="@style/Theme.MaterialComponents.Light"
                        app:strokeWidth="1dp"
                        android:visibility="gone"
                        app:strokeColor="@color/photos_stroke_color"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:cardCornerRadius="@dimen/dp8">

                        <ImageView
                            android:id="@+id/img_six"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/placeholder" />

                        <ImageView
                            android:id="@+id/img_plus_six"
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:layout_gravity="bottom|left"
                            android:padding="@dimen/dp8"

                            android:src="@drawable/about_pink"
                            android:visibility="gone"
                            app:tint="@color/colorAccent" />

                        <ImageView
                            android:id="@+id/img_edit_six"
                            android:layout_width="@dimen/dp21"
                            android:layout_height="@dimen/dp21"
                            android:layout_gravity="bottom|right"
                            android:layout_margin="@dimen/dp8"
                            android:src="@drawable/ic_group_more_hor"
                            android:visibility="gone" />

                    </com.google.android.material.card.MaterialCardView>




                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/llVideoView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llPhotoView">

                <TextView
                    style="@style/photo_header_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp24"
                    android:layout_marginRight="@dimen/dp24"
                    android:text="Profile Video"></TextView>


                <com.google.android.material.card.MaterialCardView
                    android:theme="@style/Theme.MaterialComponents.Light"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/photos_stroke_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp18"
                    android:layout_marginRight="@dimen/dp24"
                    android:layout_marginBottom="@dimen/dp24"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/dp8"
                    app:cardElevation="0dp">


                    <RelativeLayout
                        android:id="@+id/topLayout"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp125">

                        <VideoView
                            android:id="@+id/videoview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:visibility="visible" />

                        <VideoView
                            android:id="@+id/videoview2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:layout_centerInParent="true"/>

                        <ImageView
                            android:id="@+id/img_video"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp125"
                            android:background="@drawable/add_image_shape_cover"
                            android:scaleType="centerCrop" />


                    </RelativeLayout>

                    <ImageView
                        android:id="@+id/tv_delete_id"
                        android:layout_width="@dimen/dp21"
                        android:layout_height="@dimen/dp21"
                        android:layout_gravity="bottom|right"
                        android:layout_margin="@dimen/dp8"
                        android:src="@drawable/ic_group_more_hor"
                        android:visibility="gone" />
                </com.google.android.material.card.MaterialCardView>


            </LinearLayout>
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/llPVisibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:layout_weight="1"
                android:background="@color/white"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llPhotoView">

                <TextView
                    style="@style/photo_header_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp24"
                    android:layout_marginRight="@dimen/dp24"
                    android:text="Photo Visibility"></TextView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp18"
                    android:layout_marginRight="@dimen/dp24"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHide"
                        style="@style/photo_subtext_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp24"
                        android:drawableLeft="@drawable/ic_active_checked_stroke"
                        android:drawablePadding="@dimen/dp12"
                        android:gravity="center_vertical"
                        android:text="Hide for All Members"></TextView>

                    <TextView
                        android:id="@+id/tvShowAll"
                        style="@style/photo_subtext_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp24"
                        android:drawableLeft="@drawable/ic_active_checked_stroke"
                        android:drawablePadding="@dimen/dp12"
                        android:drawableTint="@color/sub_tab_default_color"
                        android:gravity="center_vertical"
                        android:text="Show Photos to All Members"></TextView>

                    <TextView
                        android:id="@+id/tvShowPremium"
                        style="@style/photo_subtext_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp24"
                        android:drawableLeft="@drawable/ic_active_checked_stroke"
                        android:drawablePadding="@dimen/dp12"
                        android:drawableTint="@color/sub_tab_default_color"
                        android:gravity="center_vertical"
                        android:text="Show Photos only to Premium Members"></TextView>

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/llPRequest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:layout_weight="1"
                android:background="@color/white"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llPVisibility">

                <TextView
                    style="@style/photo_header_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp24"
                    android:layout_marginRight="@dimen/dp24"
                    android:text="Photo Requests"></TextView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp18"
                    android:layout_marginRight="@dimen/dp24"
                    android:layout_marginBottom="@dimen/dp24"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRRequestPhoto"
                        style="@style/photo_subtext_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp24"
                        android:drawableLeft="@drawable/ic_photorequestreceivedgrey"
                        android:drawableRight="@drawable/ic_baseline_arrow_forward_ios_24"
                        android:drawablePadding="@dimen/dp12"
                        android:gravity="center_vertical"
                        android:text="Members who requested my photos"></TextView>

                    <TextView
                        android:id="@+id/tvSRequestPhoto"
                        style="@style/photo_subtext_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/ic_photorequestsentgrey"
                        android:drawableRight="@drawable/ic_baseline_arrow_forward_ios_24"
                        android:drawablePadding="@dimen/dp12"
                        android:gravity="center_vertical"
                        android:text="Whose photos I requested"></TextView>


                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/llCover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:layout_weight="1"
                android:background="@color/white"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llVideoView">

                <TextView
                    style="@style/photo_header_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp24"
                    android:layout_marginRight="@dimen/dp24"
                    android:text="Cover Photo"></TextView>


                <com.google.android.material.card.MaterialCardView
                    android:theme="@style/Theme.MaterialComponents.Light"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/photos_stroke_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp18"
                    android:layout_marginRight="@dimen/dp24"
                    android:layout_marginBottom="@dimen/dp24"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/dp8"
                    app:cardElevation="0dp">


                    <ImageView
                        android:background="@drawable/add_image_shape_cover"
                        android:id="@+id/img_cover"
                        android:layout_width="match_parent"
                        android:layout_height="125dp"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/img_plus_cover"
                        android:layout_width="@dimen/dp50"
                        android:layout_height="@dimen/dp50"
                        android:layout_gravity="bottom|left"
                        android:layout_marginLeft="8dp"
                        android:layout_marginBottom="@dimen/dp3"
                        android:padding="15dp"
                        android:src="@drawable/about_pink"
                        android:visibility="gone"
                        app:tint="@color/colorAccent" />

                    <ImageView
                        android:id="@+id/img_edit_cover"
                        android:layout_width="@dimen/dp21"
                        android:layout_height="@dimen/dp21"
                        android:layout_gravity="bottom|right"
                        android:layout_margin="@dimen/dp8"
                        android:src="@drawable/ic_group_more_hor"
                        android:visibility="gone" />

                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llIdProof"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:layout_weight="1"
                android:background="@color/white"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llCover">

                <TextView
                    style="@style/photo_header_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp24"
                    android:text="ID Proof Photo"></TextView>


                <com.google.android.material.card.MaterialCardView
                    android:theme="@style/Theme.MaterialComponents.Light"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/photos_stroke_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp18"
                    android:layout_marginRight="@dimen/dp24"
                    android:layout_marginBottom="@dimen/dp24"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/dp8">

                    <ImageView  android:background="@drawable/add_image_shape_cover"
                        android:id="@+id/img_id_proof"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp250"
                        android:scaleType="centerCrop"
                        android:src="@drawable/add_image_shape_cover" />

                    <ImageView
                        android:id="@+id/img_plus_proof"
                        android:layout_width="@dimen/dp50"
                        android:layout_height="@dimen/dp50"
                        android:layout_gravity="bottom|left"
                        android:layout_marginLeft="8dp"
                        android:layout_marginBottom="@dimen/dp3"
                        android:padding="15dp"

                        android:src="@drawable/about_pink"
                        android:visibility="gone"
                        app:tint="@color/colorAccent" />

                    <ImageView
                        android:id="@+id/img_edit_proof"
                        android:layout_width="@dimen/dp21"
                        android:layout_height="@dimen/dp21"
                        android:layout_gravity="bottom|right"
                        android:layout_margin="@dimen/dp8"
                        android:src="@drawable/ic_group_more_hor"
                        android:visibility="gone" />

                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/llHoroscope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:layout_weight="1"
                android:background="@color/white"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llIdProof">

                <TextView
                    style="@style/photo_header_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp24"
                    android:layout_marginRight="@dimen/dp24"
                    android:text="Horoscope Photo"></TextView>


                <com.google.android.material.card.MaterialCardView
                    android:theme="@style/Theme.MaterialComponents.Light"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/photos_stroke_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp18"
                    android:layout_marginRight="@dimen/dp24"
                    android:layout_marginBottom="@dimen/dp24"
