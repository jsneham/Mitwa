        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/setting_detail_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/iv1"
                android:gravity="left"
                android:text="Looking For"></TextView>

            <EditText
                android:id="@+id/et_expcts"
                style="@style/register_dropdown"
                android:layout_toRightOf="@+id/iv12"
                android:background="@null"
                android:gravity="left"
                android:hint="Expected Partner (describe in own words)" />


        </LinearLayout>
    </LinearLayout>

    <Button
        android:layout_marginBottom="@dimen/dp18"
        android:layout_marginStart="@dimen/dp18"
        android:layout_marginEnd="@dimen/dp18"
        android:id="@+id/btn_basic"
        style="@style/primary_action_button"
        android:text="@string/btn_update" />


</LinearLayout>