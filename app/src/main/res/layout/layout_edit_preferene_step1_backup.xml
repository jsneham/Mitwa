            <com.matriapp.mobile.multispinnerfilter.MultiSpinnerSearch
                android:id="@+id/spin_eat"
                style="@style/register_dropdown" android:gravity="left"
                android:layout_below="@+id/lblName8"
                android:layout_toRightOf="@+id/iv8" />
        </LinearLayout></LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"  android:background="@color/list_divider_line"/>
    <LinearLayout style="@style/edit_profile_parent_layout">

        <ImageView
            style="@style/edit_profile_icon"
            android:src="@drawable/ic_smoking_viewprofile" android:layout_alignParentLeft="true"
            android:id="@+id/iv9"/>

        <LinearLayout
            android:layout_toRightOf="@+id/iv1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:gravity="left"
                android:id="@+id/lblName9"
                style="@style/setting_detail_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
