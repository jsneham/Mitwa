                android:layout_below="@+id/lblName5"
                android:layout_toRightOf="@+id/iv5"/>
        </LinearLayout></LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"  android:background="@color/list_divider_line"/>
    <LinearLayout style="@style/edit_profile_parent_layout">

        <ImageView
            style="@style/edit_profile_icon"
            android:src="@drawable/ic_birthdate_viewprofile" android:layout_alignParentLeft="true"
            android:id="@+id/iv6"/>
        <LinearLayout
