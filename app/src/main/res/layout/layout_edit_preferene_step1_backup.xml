<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lay_basic"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:visibility="gone">

    <LinearLayout style="@style/edit_profile_parent_layout">

        <ImageView
            android:id="@+id/iv1"
            android:layout_alignParentLeft="true"
            style="@style/edit_profile_icon"
            android:src="@drawable/ic_maritalstatus_viewprofile" />
        <LinearLayout
            android:layout_toRightOf="@+id/iv1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/lblName1"
                style="@style/setting_detail_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/iv1"
                android:gravity="left"
                android:text="Marital Status"></TextView>

            <com.matriapp.mobile.multispinnerfilter.MultiSpinnerSearch
                android:id="@+id/spin_looking"
                style="@style/register_dropdown"
                android:gravity="left"
                android:layout_below="@+id/lblName1"
                android:layout_toRightOf="@+id/iv1" />
        </LinearLayout></LinearLayout>
    <View
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"  android:background="@color/list_divider_line"/>
    <LinearLayout android:visibility="gone" style="@style/edit_profile_parent_layout">

        <ImageView
            style="@style/edit_profile_icon"
            android:src="@drawable/ic_skincolor_viewprofile"
            android:layout_alignParentLeft="true"
            android:id="@+id/iv2"/>
        <LinearLayout
            android:layout_toRightOf="@+id/iv1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:gravity="left"
                android:id="@+id/lblName2"
                style="@style/setting_detail_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/iv2"
                android:text="Partner Complexion"></TextView>

            <com.matriapp.mobile.multispinnerfilter.MultiSpinnerSearch
                android:id="@+id/spin_complx"
                style="@style/register_dropdown" android:gravity="left"
                android:layout_below="@+id/lblName2"
                android:layout_toRightOf="@+id/iv2" />
        </LinearLayout></LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"  android:background="@color/list_divider_line"/>
    <LinearLayout style="@style/edit_profile_parent_layout">

        <ImageView
            style="@style/edit_profile_icon"
            android:src="@drawable/ic_heightage_viewprofile"
            android:layout_alignParentLeft="true"
            android:id="@+id/iv3"/>
        <LinearLayout
            android:layout_toRightOf="@+id/iv1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:gravity="left"
                android:id="@+id/lblName3"
                style="@style/setting_detail_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/iv3"
                android:text="@string/minimum_height"></TextView>
            <com.matriapp.mobile.multispinnerfilter.SingleSpinnerSearch
                android:id="@+id/spin_height_from"
                style="@style/register_dropdown"
                android:gravity="left"
                android:layout_below="@+id/lblName3"
                android:layout_toRightOf="@+id/iv3"/>
        </LinearLayout></LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"  android:background="@color/list_divider_line"/>
    <LinearLayout style="@style/edit_profile_parent_layout">

