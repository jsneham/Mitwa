<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@color/White"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:fitsSystemWindows="true"
    android:focusableInTouchMode="true"
    tools:context=".activities.ChatConversationActivity">

<!--    <com.google.android.material.appbar.AppBarLayout-->
<!--        android:id="@+id/appBarLayout"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintTop_toTopOf="parent">-->

        <androidx.appcompat.widget.Toolbar
            android:layout_alignParentTop="true"
            app:contentInsetLeft="0dp"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp"
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/gradient_toolbar"
            android:theme="@style/toolbar_theme"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_scrollFlags="scroll|enterAlways"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" >

            <RelativeLayout

                android:gravity="center_vertical"
                android:id="@+id/llHeader"
                android:layout_marginRight="@dimen/dp5"
                android:layout_marginBottom="@dimen/dp5"
                android:layout_marginTop="@dimen/dp5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/img_title_profile"
                    android:layout_width="@dimen/dp40"
                    android:layout_height="@dimen/dp40"
                    android:src="@drawable/placeholder"/>

            </RelativeLayout>




            <LinearLayout
                android:layout_toRightOf="@+id/cvImage"
                android:layout_centerInParent="true"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginRight="@dimen/dp12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_page_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/semi_bold_slnt" />

                <RelativeLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_alignParentLeft="true"
                        android:fontFamily="@font/regular_slnt"
                        android:id="@+id/tv_online"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Online"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:visibility="visible" />

                    <TextView
                    android:layout_alignParentRight="true"
                    android:layout_gravity="right"
                    android:onClick="openActivity"
                    android:text="view profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/transparent_white"
                    android:textSize="@dimen/sp11"
                    android:fontFamily="@font/thin_slnt"
                    />
                </RelativeLayout>

            </LinearLayout>


        </androidx.appcompat.widget.Toolbar>

<!--    </com.google.android.material.appbar.AppBarLayout>-->

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/linearLayout9"
        android:layout_below="@+id/toolbar"
        android:layout_marginLeft="@dimen/dp18"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp18">

        <ListView
            android:id="@+id/lv_list"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:divider="@null" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
    android:layout_alignParentBottom="true"
    android:layout_marginLeft="@dimen/dp24"
    android:layout_marginTop="@dimen/dp12"
    android:layout_marginRight="@dimen/dp24"
    android:layout_marginBottom="@dimen/dp12"
    android:id="@+id/linearLayout9"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp48"
    android:gravity="center"
    android:orientation="horizontal">

        <EditText
            android:fontFamily="@font/regular_slnt"
            android:textSize="13sp"
            android:layout_marginRight="@dimen/dp12"
            android:id="@+id/et_message"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp45"
            android:layout_weight="1"
            android:paddingLeft="@dimen/dp15"
            android:background="@drawable/chat_text_background"
            android:hint="Type Here"
            />

        <ImageButton
            android:background="@drawable/send_background"
            android:id="@+id/btn_send"
            android:layout_width="@dimen/dp45"
            android:layout_height="@dimen/dp45"
            android:src="@drawable/ic_menu_send"
            app:tint="@color/White" />
    </LinearLayout>

    <include
        layout="@layout/layout_loader"
        android:visibility="gone" />

</RelativeLayout>