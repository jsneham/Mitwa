<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lay_first"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dp18"
    android:background="@color/registration_background1"
    android:orientation="vertical">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp18"
        android:layout_marginRight="@dimen/dp18"
        android:layout_marginBottom="@dimen/dp12">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="goBack"
            android:src="@drawable/back" />

        <TextView
            style="@style/skip_now_small_header_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:gravity="center_vertical"
            android:onClick="onSkipClick"
            android:text="@string/skip_new"
            android:textColor="@color/skip_now"
            android:textStyle="italic" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp18"
        android:layout_marginRight="@dimen/dp18"
        android:orientation="horizontal">


        <TextView
            android:gravity="center_vertical"
            style="@style/small_header_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:text="@string/profile_details_lifestyle_amp_appearance"
            android:textColor="@color/colorAccent" />

    </RelativeLayout>


    <TextView
        style="@style/registration_header_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp18"
        android:layout_marginBottom="@dimen/dp10"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginRight="@dimen/dp18"
        android:text="@string/hobbies_amp_interest_s"
        android:textColor="@color/actual_black"
        android:textStyle="bold" />

<!--    <androidx.core.widget.NestedScrollView-->

<!--        android:fillViewport="true"-->
<!--        app:layout_behavior="@string/appbar_scrolling_view_behavior"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent">-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/registration_background2">
        <RelativeLayout
            android:layout_margin="@dimen/dp18"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <RelativeLayout
            android:layout_above="@+id/btn_first_submit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/registration_background2"
            android:orientation="vertical">


            <EditText

                android:id="@+id/et_hoby"
                android:background="@drawable/login_text_background"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:layout_gravity="top"
                android:fontFamily="@font/regular_slnt"
                android:gravity="top"
                android:maxLength="250"
                android:hint="Mention Hobbies &amp; Interest(s) here. e.g. Travelling &amp; exploring, reading, gardening, learning new languages, etc"
                android:inputType="textMultiLine"
                android:paddingLeft="15dp"
                android:paddingTop="10dp"
                android:paddingRight="15dp"
                android:textColorHint="@color/description_text1">

            </EditText>

            <View
                android:visibility="gone"
                android:layout_below="@+id/et_hoby"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/text_divider_line" />

        </RelativeLayout>
            <Button
                android:layout_alignParentBottom="true"
                android:id="@+id/btn_first_submit"
                android:layout_marginTop="@dimen/dp18"
                android:onClick="validFirst"
                android:text="Continue"
                android:textAllCaps="false"
                android:textColor="@color/White"
                android:background="@drawable/round_background"
                android:fontFamily="@font/semi_bold_slnt"
                android:textSize="@dimen/sp15"
                android:elevation="0dp"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"/>


            <include
                android:id="@+id/progressBar"
                android:visibility="gone"
                layout="@layout/layout_loader"/>
        </RelativeLayout>
    </LinearLayout>
<!--    </androidx.core.widget.NestedScrollView>-->
</LinearLayout>