<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/dp12"
    app:cardUseCompatPadding="true">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp16"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/linearLayout7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:layout_toLeftOf="@+id/tv_duration"
                android:id="@+id/tv_name"
                style="@style/plan_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:gravity="left"
                android:maxLines="2"
                android:text="" />


            <TextView
                android:id="@+id/tv_duration"
                style="@style/plan_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:gravity="right"
                android:maxLength="10"
                android:text="365 Days" />


        </RelativeLayout>

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/linearLayout7"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginBottom="@dimen/dp6"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_discount"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp30"
                    android:background="@drawable/round_corner_disscount"
                    android:fontFamily="@font/semi_bold_slnt"
                    android:gravity="center_vertical|center"
                    android:text="45% semibold15"
                    android:paddingLeft="@dimen/dp10"
                    android:paddingRight="@dimen/dp10"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp13" />

                <TextView
                    android:id="@+id/tv_org_prise"
                    style="@style/plan_price_main"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/dp15"
                    android:gravity="center_vertical|center"
                    android:text="₹ 1000" />
            </LinearLayout>


            <TextView
                android:id="@+id/lblPlanAmount"
                style="@style/plan_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="₹ 30 Bold" />


            <TextView
                android:id="@+id/tv_per_day"
                style="@style/plan_per_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp2"
                android:layout_marginBottom="@dimen/dp16"
                android:gravity="center"
                android:text="₹ 1.15 per day Semibold12" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/linearLayout3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/linearLayout2"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_profile_data"
                style="@style/plan_subtext_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/plan_activie_check"
                android:drawablePadding="@dimen/dp8"
                android:text="Your One Pager Bio-Data" />

            <TextView
                android:id="@+id/tv_profile_view"
                style="@style/plan_subtext_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:drawableLeft="@drawable/plan_activie_check"
                android:drawablePadding="@dimen/dp8"
                android:text="Profile view" />

            <TextView
                style="@style/plan_subtext_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:drawableLeft="@drawable/plan_activie_check"
                android:drawablePadding="@dimen/dp8"
                android:text="Search &amp; Save Profiles " />

            <TextView
                style="@style/plan_subtext_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:drawableLeft="@drawable/plan_activie_check"
                android:drawablePadding="@dimen/dp8"
                android:text="Contact Matchmaker" />


            <TextView
                android:id="@+id/tv_contact"
                style="@style/plan_subtext_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:drawableLeft="@drawable/plan_activie_check"
                android:drawablePadding="@dimen/dp8"
                android:text="10 Contact Numbers of Profile(s)"
                android:visibility="visible" />

            <TextView
                android:id="@+id/tv_chat"
                style="@style/plan_subtext_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:drawableLeft="@drawable/plan_activie_check"
                android:drawablePadding="@dimen/dp8"
                android:text="Live Chat"
                android:visibility="visible" />


            <TextView
                android:id="@+id/tv_message"
                style="@style/plan_subtext_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:drawableLeft="@drawable/plan_activie_check"
                android:drawablePadding="@dimen/dp8"
                android:text="Message"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_video"
                style="@style/plan_subtext_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/plan_activie_check"
                android:drawablePadding="@dimen/dp8"
                android:text="Video"
                android:visibility="gone" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/linearLayout4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/linearLayout3"
            android:layout_marginTop="@dimen/dp14"
            android:layout_marginBottom="@dimen/dp14"
            android:background="@drawable/round_background_corner"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/tv_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/medium_slnt"
                android:inputType="textMultiLine"
                android:padding="@dimen/dp8"
                android:text="100% Personalize \nService djndsjvdsjvsdnjvdsjvdsjvndsvndsvjsdvjsdvjdsvjdsvdsjvsdjvdsjbvdsjvsdvjbsdvjdjvdsssssssssssssvgggfghchxchxccxcvbcv\nbcvxbcvxbcx\ngcvgcvgcvxccvxcg/n14sp"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/sp8" />
        </LinearLayout>

        <Button
            android:gravity="center_vertical|center"
            android:id="@+id/btn_id"
            style="@style/pay_continue_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp39"
            android:layout_below="@+id/linearLayout4"
            android:text="Continue"
            android:textAllCaps="false" />



    </RelativeLayout>

</androidx.core.widget.NestedScrollView>

</androidx.cardview.widget.CardView>

