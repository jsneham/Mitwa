                android:background="@color/list_divider_line" />

            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/iv5"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_birthdate_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName5"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv5"
                        android:gravity="left"
                        android:text="From Age"></TextView>

                    <com.matriapp.mobile.multispinnerfilter.SingleSpinnerSearch
                        android:id="@+id/spin_age_from"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName5"
                        android:layout_toRightOf="@+id/iv5"
                        android:gravity="left" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp20"
                android:layout_marginRight="@dimen/dp20"
                android:background="@color/list_divider_line" />

            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/iv6"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_birthdate_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
