            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp20"
                android:layout_marginRight="@dimen/dp20"
                android:background="@color/list_divider_line" />

            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/iv11"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_mothertongue_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName11"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv11"
                        android:gravity="left"
                        android:text="Mother Tongue"></TextView>

                    <com.matriapp.mobile.multispinnerfilter.MultiSpinnerSearch
                        android:id="@+id/spin_mtongue"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName11"
                        android:layout_toRightOf="@+id/iv11"
                        android:gravity="left" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp20"
                android:layout_marginRight="@dimen/dp20"
                android:background="@color/list_divider_line" />

            <LinearLayout style="@style/edit_profile_parent_layout" android:visibility="gone">

                <ImageView
                    android:id="@+id/iv12"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_expectations_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv1"
                        android:gravity="left"
                        android:text="Looking For"></TextView>

                    <EditText
                        android:id="@+id/et_expcts"
                        style="@style/register_dropdown"
                        android:layout_toRightOf="@+id/iv12"
                        android:background="@null"
                        android:gravity="left"
                        android:hint="Expectations from Desired Partner (Describe in own words)" />


                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/llTwo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/registration_background2">
        <Button
            android:id="@+id/btn_basic"
            style="@style/primary_action_button"
            android:layout_alignParentBottom="true"
            android:text="@string/btn_update" />

    </LinearLayout>



