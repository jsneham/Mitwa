<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lay_basic"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:visibility="gone">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/llTwo"
        android:layout_alignParentTop="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/iv1"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_maritalstatus_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName1"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv1"
                        android:gravity="left"
                        android:text="Marital Status"></TextView>

                    <com.matriapp.mobile.multispinnerfilter.MultiSpinnerSearch
                        android:id="@+id/spin_looking"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName1"
                        android:layout_toRightOf="@+id/iv1"
                        android:gravity="left" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp20"
                android:layout_marginRight="@dimen/dp20"
                android:background="@color/list_divider_line" />

            <LinearLayout
                style="@style/edit_profile_parent_layout"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv2"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_skincolor_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName2"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv2"
                        android:gravity="left"
                        android:text="Partner Complexion"></TextView>

                    <com.matriapp.mobile.multispinnerfilter.MultiSpinnerSearch
                        android:id="@+id/spin_complx"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName2"
                        android:layout_toRightOf="@+id/iv2"
                        android:gravity="left" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp20"
                android:layout_marginRight="@dimen/dp20"
                android:background="@color/list_divider_line" />

            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/iv3"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_heightage_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName3"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
