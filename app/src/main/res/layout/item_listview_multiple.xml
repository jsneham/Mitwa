<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/registration_background2">

    <LinearLayout
        android:layout_marginLeft="@dimen/dp18"
        android:layout_marginRight="@dimen/dp18"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginBottom="@dimen/dp10"
        android:weightSum="2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_weight="2"
            android:layout_alignParentLeft="true"
            android:layout_gravity="center|center_vertical"
            android:id="@+id/alertTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="Item Name"
            android:textSize="@dimen/sp18"
            android:textColor="@color/default_small_text_title1"
            android:fontFamily="@font/medium_slnt"
            />
        <CheckBox
            android:layout_gravity="right"
            android:gravity="center_vertical|right"
            android:id="@+id/alertCheckbox"
            android:layout_width="@dimen/dp26"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:buttonTint="@color/colorAccent"
            android:clickable="false" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
