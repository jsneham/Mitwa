<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/llView"
    tools:context=".fragments.ProfileVerification.PhotoVerificationFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp20">

        <LinearLayout
            android:layout_marginBottom="@dimen/dp30"
            android:id="@+id/one"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="@drawable/verification_background">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/dp16"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/profile_verification_profilephoto" />

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/adhar_pan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp10"
                    android:layout_toRightOf="@+id/iv"
                    android:text="Profile Photo" />

                <TextView
                    android:id="@+id/tvDescription"
                    style="@style/adhar_pan_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tvTitle"
                    android:layout_marginLeft="@dimen/dp10"
                    android:layout_toRightOf="@+id/iv"
                    android:text="Please Upload your Govt. ID to verify your profile photo" />
            </RelativeLayout>
        </LinearLayout>



        <TextView
            android:id="@+id/btnNeedHelp"
            style="@style/popup_bottom_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="Need Help?"
            android:textColor="@color/colorAccent"
            android:visibility="gone"/>

    </RelativeLayout>

    <include
        layout="@layout/layout_loader"
        android:visibility="gone" />
</RelativeLayout>