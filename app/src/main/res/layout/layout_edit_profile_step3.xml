<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lay_about"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <androidx.core.widget.NestedScrollView
        android:layout_above="@+id/btn_about"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/iv1"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:scaleType="fitStart"
                    android:src="@drawable/ic_aboutprofile_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName1"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv1"
                        android:gravity="left"
                        android:text="About"></TextView>

                    <EditText
                        android:id="@+id/et_about"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName1"
                        android:layout_toRightOf="@+id/iv1"
                        android:background="@null"
                        android:gravity="left"
                        android:hint="Write something about Yourself" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp18"
                android:layout_marginRight="@dimen/dp18"
                android:background="@color/list_divider_line" />

            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/i1"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_hobbies_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/l1"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/i1"
                        android:gravity="left"
                        android:text="@string/hobbies_amp_interest_s"></TextView>

                    <EditText
                        android:id="@+id/et_hoby"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/l1"
                        android:layout_toRightOf="@+id/i1"
                        android:background="@null"
                        android:gravity="left"
                        android:hint="@string/hobbies_amp_interest_s_in_own_words" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp18"
                android:layout_marginRight="@dimen/dp18"
                android:background="@color/list_divider_line" />


            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/i2"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_birthplacecity_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/l2"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/i2"
                        android:gravity="left"
                        android:text="City of Birth"></TextView>

                    <EditText
                        android:id="@+id/et_birth_place"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/l2"
                        android:layout_toRightOf="@+id/i2"
                        android:background="@null"
                        android:gravity="left"
                        android:hint="City of Birth" />

                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp18"
                android:layout_marginRight="@dimen/dp18"
                android:background="@color/list_divider_line" />

            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/i3"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_birthtime_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/l3"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/i3"
                        android:gravity="left"
                        android:text="Birth Time"></TextView>

                    <EditText
                        android:id="@+id/et_birth_time"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/l3"
                        android:layout_toRightOf="@+id/i3"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="false"
                        android:gravity="left"
                        android:hint="Birth Time"
                        android:inputType="none" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp18"
                android:layout_marginRight="@dimen/dp18"
                android:background="@color/list_divider_line" />


            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/iv2"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_createdby_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName2"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv2"
                        android:gravity="left"
                        android:text="Profile Created By"></TextView>

                    <com.matriapp.mobile.multispinnerfilter.SingleSpinnerSearch
                        android:id="@+id/spin_created"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName2"
                        android:layout_toRightOf="@+id/iv2"
                        android:gravity="left" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp18"
                android:layout_marginRight="@dimen/dp18"
                android:background="@color/list_divider_line" />

            <LinearLayout
                style="@style/edit_profile_parent_layout"
                android:clickable="false">

                <ImageView
                    android:id="@+id/iv3"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_referredby_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName3"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv3"
                        android:gravity="left"
                        android:text="Referred By"></TextView>

                    <TextView
                        android:id="@+id/spin_refe_text"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName3"
                        android:layout_toRightOf="@+id/iv3"
                        android:background="@null"
                        android:gravity="left" />

                    <com.matriapp.mobile.multispinnerfilter.SingleSpinnerSearch
                        android:id="@+id/spin_reference"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName3"
                        android:layout_toRightOf="@+id/iv3"
                        android:gravity="left"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btn_about"
        style="@style/primary_action_button"
        android:layout_alignParentBottom="true"
        android:text="Update" />

</RelativeLayout>