<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:behavior_hideable="true"
    app:behavior_peekHeight="@dimen/dp8"
    app:cardElevation="@dimen/dp12"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <LinearLayout
        android:id="@+id/llTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/tvMessage"
            android:layout_marginLeft="@dimen/dp18"
            android:layout_marginRight="@dimen/dp18"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp16"
                style="@style/verify_header_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alert"  />

            <ImageView
                android:layout_marginTop="@dimen/dp15"
                android:layout_marginBottom="@dimen/dp15"
                android:layout_alignParentRight="true"
                android:src="@drawable/close_pop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp1"
            android:background="@color/lighter_gray" />


        <TextView
            android:id="@+id/tvMessageDescription"
            android:layout_marginLeft="@dimen/dp18"
            android:layout_marginRight="@dimen/dp18"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginBottom="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:fontFamily="@font/medium_slnt"
            android:textColor="@color/llTerms"
            android:textSize="@dimen/sp14"
            android:text="@string/this_number_is_not_registered"
            android:visibility="visible" />


        <LinearLayout
            android:layout_marginBottom="@dimen/dp16"
            android:layout_marginLeft="@dimen/dp18"
            android:layout_marginRight="@dimen/dp18"
            android:layout_marginTop="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCreate"
                android:layout_weight="1"
                style="@style/popup_bottom_button"
                android:layout_marginRight="@dimen/dp12"
                android:background="@drawable/round_primary_button_border"
                android:text="Need Help?"
                android:textColor="@color/colorAccent"
                />

            <androidx.appcompat.widget.AppCompatButton
                style="@style/popup_bottom_button"
                android:id="@+id/btnTry"
                android:layout_weight="1"
                android:background="@drawable/error_round_primary_button"
                android:text="Try Again"
                android:textColor="@color/white"
                />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>