<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="@dimen/dp5"
    android:paddingRight="@dimen/dp5">


    <androidx.cardview.widget.CardView
        android:id="@+id/llTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:cardCornerRadius="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        android:layout_marginRight="@dimen/dp12"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginBottom="@dimen/dp12">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/viewA"
                    android:layout_width="match_parent"
                    android:layout_height="330dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/img_profile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:scaleType="centerCrop"
                            android:src="@drawable/placeholder" />
                    </RelativeLayout>

                    <ImageView
                        android:id="@+id/img_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right|top"
                        android:layout_marginTop="@dimen/dp18"
                        android:layout_marginRight="@dimen/dp18"
                        android:src="@drawable/ic_whte70" />

                    <ImageView
                        android:id="@+id/imgPLanStamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left|top"
                        android:src="@drawable/ic_demo_platinum"
                        android:textColor="@color/white"
                        android:visibility="gone"/>

                    <ImageView
                        android:id="@+id/btn_interest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|right"
                        android:layout_marginRight="@dimen/dp9"
                        android:layout_marginBottom="@dimen/dp18"
                        android:backgroundTint="@color/transparent"
                        android:src="@drawable/send_interest"
                        app:elevation="@dimen/dp2" />
                    <!--                        app:maxImageSize="@dimen/dp56"/>-->

                    <ImageView
                        android:id="@+id/tvInSent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|left"
                        android:background="@drawable/ic_preferredmatch_left_interest_sent"
                        android:visibility="gone" />
                    <!--                    <TextView-->
                    <!--                        android:textSize="12sp"-->
                    <!--                        android:visibility="gone"-->
                    <!--                        android:id="@+id/tvInSent"-->
                    <!--                        android:fontFamily="@font/regular_slnt"-->
                    <!--                        android:padding="@dimen/dp5"-->
                    <!--                        android:drawablePadding="@dimen/dp5"-->
                    <!--                        android:gravity="center_vertical"-->
                    <!--                        android:drawableRight="@drawable/interest_icon"-->
                    <!--                        android:text="INTEREST SENT"-->
                    <!--                        android:textColor="@color/white"-->
                    <!--                        android:layout_gravity="bottom|left"-->
                    <!--                        android:background="@color/colorAccent"-->
                    <!--                        android:layout_width="wrap_content"-->
                    <!--                        android:layout_height="wrap_content"/>-->

                </FrameLayout>


                <LinearLayout
                    android:id="@+id/viewB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp18"
                    android:layout_marginTop="@dimen/dp14"
                    android:layout_marginRight="@dimen/dp18"
                    android:layout_marginBottom="@dimen/dp14"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="0"
                        >

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_mid"
                                style="@style/preferred_small_header_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/tv_name"
                                style="@style/preferred_medium_header_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/tv_detail"
                                style="@style/preferred_medium_details_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="6" />
                        </LinearLayout>

<!--                        <LinearLayout-->
<!--                            android:layout_width="wrap_content"-->
<!--                            android:layout_height="wrap_content"-->
<!--                            android:layout_gravity="right"-->
<!--                            android:layout_weight="0"-->
<!--                            android:gravity="right"-->
<!--                            android:orientation="vertical">-->

<!--                            <ImageView-->
<!--                                android:id="@+id/ivShort"-->
<!--                                android:layout_width="@dimen/dp30"-->
<!--                                android:layout_height="@dimen/dp30"-->
<!--                                android:layout_marginLeft="@dimen/dp9"-->
<!--                                android:layout_marginRight="@dimen/dp9"-->
<!--                                android:src="@drawable/ic_shortliststroke"></ImageView>-->


<!--                            <ImageView-->
<!--                                android:id="@+id/btn_chat"-->
<!--                                android:layout_width="@dimen/dp30"-->
<!--                                android:layout_height="@dimen/dp30"-->
<!--                                android:layout_marginLeft="@dimen/dp18"-->
<!--                                android:layout_marginTop="@dimen/dp9"-->
<!--                                android:layout_marginRight="@dimen/dp9"-->
<!--                                android:src="@drawable/ic_messagestroke">-->

<!--                            </ImageView>-->


<!--                        </LinearLayout>-->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center|center_vertical"
                            android:gravity="center"
                            android:layout_weight="0"
                            android:orientation="vertical">
                            <ImageView

                                android:layout_marginLeft="@dimen/dp8"
                                android:layout_marginRight="@dimen/dp8"
                                android:layout_marginBottom="@dimen/dp4"
                                android:id="@+id/ivShort"
                                android:layout_width="@dimen/dp24"
                                android:layout_height="@dimen/dp24"
                                android:src="@drawable/ic_shortliststroke"></ImageView>


                            <ImageView
                                android:id="@+id/btn_chat"
                                android:layout_marginLeft="@dimen/dp8"
                                android:layout_marginRight="@dimen/dp8"
                                android:layout_marginTop="@dimen/dp4"
                                android:layout_width="@dimen/dp24"
                                android:layout_height="@dimen/dp24"
                                android:src="@drawable/ic_messagestroke"></ImageView>

                        </LinearLayout>
                    </LinearLayout>


                    <!--                    <TextView-->
                    <!--                        android:id="@+id/tv_detail"-->
                    <!--                        style="@style/preferred_medium_details_text"-->
                    <!--                        android:layout_width="202dp"-->
                    <!--                        android:layout_height="wrap_content"-->
                    <!--                        android:maxLines="6" />-->

                </LinearLayout>
            </LinearLayout>


        </androidx.coordinatorlayout.widget.CoordinatorLayout>


    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>