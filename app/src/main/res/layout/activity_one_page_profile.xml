                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/semi_bold_slnt"
                    android:text="@string/family_info"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/sp8" />

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Ancestral Origin" />

                    <TextView
                        android:id="@+id/tvAddress"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Family Affluence" />

                    <TextView
                        android:id="@+id/tvFStatus"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Family Type" />

                    <TextView
                        android:id="@+id/tvFType"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Father’s Name" />

                    <TextView
                        android:id="@+id/tvFather"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Father's Occupation" />

                    <TextView
                        android:id="@+id/tvFatherOcc"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Mother’s Name" />

                    <TextView
                        android:id="@+id/tvMother"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Mother's Occupation" />

                    <TextView
                        android:id="@+id/tvMotherOcc"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Brother(s)" />

                    <TextView
                        android:id="@+id/tvBrother"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Sister(s)" />

                    <TextView
                        android:id="@+id/tvSister"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        style="@style/one_pager_subtitle"
