                    <TextView
                        android:id="@+id/tvHealthInfo"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp8"
            android:layout_marginRight="@dimen/dp8"
            android:layout_weight="1"
            android:orientation="vertical"
            android:weightSum="3">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/semi_bold_slnt"
                    android:text="@string/edu_profes"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/sp8" />

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Highest Qualification" />

                    <TextView
                        android:id="@+id/tvEducation"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Work Sector" />

                    <TextView
                        android:id="@+id/tvProfession"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Annual Income" />

                    <TextView
                        android:id="@+id/tvIncome"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Occupation" />

                    <TextView
                        android:id="@+id/tvOccupation"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>


                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Designation" />

                    <TextView
                        android:id="@+id/tvDesignation"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Additional Info." />

                    <TextView
                        android:id="@+id/tvAddInfo"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        />
                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp14"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/semi_bold_slnt"
                    android:text="@string/religion_amp_astro_details"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/sp8" />

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Gothram" />

                    <TextView
                        android:id="@+id/tvGothram"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Horoscope belief" />

                    <TextView
                        android:id="@+id/tvHoroscope"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Raas (Moonsign)" />

                    <TextView
                        android:id="@+id/tvRaas"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Star" />

                    <TextView
                        android:id="@+id/tvStar"
                        style="@style/one_pager_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Is Manglik?" />

                    <TextView
                        android:id="@+id/tvMangalik"
                        style="@style/one_pager_child"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Blood Group" />

                    <TextView
                        android:id="@+id/tvBloodGroup"
                        style="@style/one_pager_child"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Born Place" />

                    <TextView
                        android:id="@+id/tvBirthPlace"
                        style="@style/one_pager_child"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    style="@style/one_pager_linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/one_pager_subtitle"
                        android:layout_height="wrap_content"
                        android:text="Born on" />

                    <TextView
                        android:id="@+id/tvBirthday"
                        style="@style/one_pager_child"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
