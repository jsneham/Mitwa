            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/semi_bold_slnt"
                    android:text="EXPECTATION FROM DESIREED PARTNER"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/sp8" />

                <TextView
                    android:id="@+id/tvLookinFor"
                    style="@style/one_pager_child"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/ic_one_looking" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorAccent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvName"
                    style="@style/one_pager_child"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/gradient_color_1">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/regular_slnt"
            android:gravity="center"
            android:text="@string/bio_data_created_to_find_suitable_alliance_for_marriage_misuse_may_lead_to_legal_action"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="6sp"></TextView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/ivDownload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/dp18"
        android:layout_marginTop="@dimen/dp18"
        android:layout_marginEnd="@dimen/dp18"
        android:layout_marginBottom="@dimen/dp18"
        android:backgroundTint="@color/gradient_color_1"
        android:onClick="downloadPdf"
        android:src="@drawable/ic_baseline_file_download_24" />

    <include
        android:id="@+id/progressBar"
        layout="@layout/layout_loader"
        android:visibility="gone" />
</RelativeLayout>