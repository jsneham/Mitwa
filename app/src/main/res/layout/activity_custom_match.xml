<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:id="@+id/llContent"
    tools:context=".activities.CustomMatchActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimary"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    </com.google.android.material.appbar.AppBarLayout>

    <com.matriapp.mobile.cardstackview.CardStackView
        android:visibility="gone"
        android:id="@+id/swipeStack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="3dp"
        android:clipToPadding="false"
        android:paddingTop="70dp" />

    <ListView
        android:layout_marginTop="43dp"
        android:id="@+id/lv_match"
        android:divider="@null"
        app:layout_anchor="@+id/rlTop"
        app:layout_anchorGravity="right|center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <TextView
        android:fontFamily="@font/regular_slnt"
        android:id="@+id/tv_no_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="No Data Available"
        android:textColor="@color/actual_black"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_anchor="@+id/lv_match"
        app:layout_anchorGravity="right|center" />

    <include layout="@layout/custom_match_sheet" />

    <include
        layout="@layout/layout_loader"
        android:visibility="gone"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>