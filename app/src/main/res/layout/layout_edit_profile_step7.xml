<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lay_family"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dp18"
    android:visibility="gone">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/btn_family"
        android:layout_alignParentTop="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/iv1"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_familystatustype_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName1"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv1"
                        android:gravity="left"
                        android:text="Family Type"></TextView>

                    <com.matriapp.mobile.multispinnerfilter.SingleSpinnerSearch
                        android:id="@+id/spin_family_type"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName1"
                        android:layout_toRightOf="@+id/iv1"
                        android:gravity="left" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp18"
                android:layout_marginRight="@dimen/dp18"
                android:background="@color/list_divider_line" />

            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/i1"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_father_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lbl1"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/i1"
                        android:gravity="left"
                        android:text="Father's Name"></TextView>

                    <EditText
                        android:id="@+id/et_father_name"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lbl1"
                        android:layout_toRightOf="@+id/i1"
                        android:background="@null"
                        android:gravity="left"
                        android:hint="Enter Father's Name" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp18"
                android:layout_marginRight="@dimen/dp18"
                android:background="@color/list_divider_line" />

            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/i2"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_fatheroccupation_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lbl2"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/i2"
                        android:gravity="left"
                        android:text="Father's Occupation"></TextView>

                    <EditText
                        android:id="@+id/et_father_ocu"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lbl2"
                        android:layout_toRightOf="@+id/i2"
                        android:background="@null"
                        android:gravity="left"
                        android:hint="Enter Father's Occupation" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp18"
                android:layout_marginRight="@dimen/dp18"
                android:background="@color/list_divider_line" />

            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/i3"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_mother_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lbl3"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/i3"
                        android:gravity="left"
                        android:text="Mother's Name"></TextView>

                    <EditText
                        android:id="@+id/et_mother_name"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lbl3"
                        android:layout_toRightOf="@+id/i3"
                        android:background="@null"
                        android:gravity="left"
                        android:hint="Enter Mother's Name" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp18"
                android:layout_marginRight="@dimen/dp18"
                android:background="@color/list_divider_line" />

            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/i4"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_motheroccupation_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lbl4"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/i4"
                        android:gravity="left"
                        android:text="Mother's Occupation"></TextView>

                    <EditText
                        android:id="@+id/et_mother_ocu"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lbl4"
                        android:layout_toRightOf="@+id/i4"
                        android:background="@null"
                        android:gravity="left"
                        android:hint="Enter Mother's Occupation" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp18"
                android:layout_marginRight="@dimen/dp18"
                android:background="@color/list_divider_line" />

            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/iv2"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_familystatustype_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName2"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv2"
                        android:gravity="left"
                        android:text="Family Status"></TextView>

                    <com.matriapp.mobile.multispinnerfilter.SingleSpinnerSearch
                        android:id="@+id/spin_family_status"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName2"
                        android:layout_toRightOf="@+id/iv2"
                        android:gravity="left" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp18"
                android:layout_marginRight="@dimen/dp18"
                android:background="@color/list_divider_line" />

            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/iv3"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_brother_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName3"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv3"
                        android:gravity="left"
                        android:text="No. of Brother(s)"></TextView>

                    <com.matriapp.mobile.multispinnerfilter.SingleSpinnerSearch
                        android:id="@+id/spin_no_bro"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName3"
                        android:layout_toRightOf="@+id/iv3"
                        android:gravity="left" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp18"
                android:layout_marginRight="@dimen/dp18"
                android:background="@color/list_divider_line" />

            <LinearLayout
                android:id="@+id/llMarriedBrother"
                style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/iv4"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_marriedbrother_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName4"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv4"
                        android:gravity="left"
                        android:text="Married Brother(s)"></TextView>

                    <com.matriapp.mobile.multispinnerfilter.SingleSpinnerSearch
                        android:id="@+id/spin_no_mari_bro"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName4"
                        android:layout_toRightOf="@+id/iv4"
                        android:gravity="left" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp18"
                android:layout_marginRight="@dimen/dp18"
                android:background="@color/list_divider_line" />

            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/iv5"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_sister_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName5"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv5"
                        android:gravity="left"
                        android:text="No. of Sister(s)"></TextView>

                    <com.matriapp.mobile.multispinnerfilter.SingleSpinnerSearch
                        android:id="@+id/spin_no_sis"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName5"
                        android:layout_toRightOf="@+id/iv5"
                        android:gravity="left" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp18"
                android:layout_marginRight="@dimen/dp18"
                android:background="@color/list_divider_line" />

            <LinearLayout
                android:id="@+id/llMarriedSister"
                style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/iv6"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_marriedsister_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName6"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv6"
                        android:gravity="left"
                        android:text="Married Sister(s)"></TextView>

                    <com.matriapp.mobile.multispinnerfilter.SingleSpinnerSearch
                        android:id="@+id/spin_no_mari_sis"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName6"
                        android:layout_toRightOf="@+id/iv6"
                        android:gravity="left" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp18"
                android:layout_marginRight="@dimen/dp18"
                android:background="@color/list_divider_line" />

            <LinearLayout style="@style/edit_profile_parent_layout">

                <ImageView
                    android:id="@+id/iv7"
                    style="@style/edit_profile_icon"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_aboutfamily_viewprofile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName7"
                        style="@style/setting_detail_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv7"
                        android:gravity="left"
                        android:text="About My Family"></TextView>

                    <EditText
                        android:id="@+id/et_about_family"
                        style="@style/register_dropdown"
                        android:layout_below="@+id/lblName7"
                        android:layout_toRightOf="@+id/iv7"
                        android:background="@null"
                        android:gravity="left"
                        android:hint="Write About Your Family" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btn_family"
        style="@style/primary_action_button"
        android:layout_alignParentBottom="true"
        android:text="Update" />

</RelativeLayout>